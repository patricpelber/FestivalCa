<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/bg_r1"/>
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_vertical|start"
        android:padding="14dp">
        <TextClock
            android:id="@+id/time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="hh:mm a" android:format24Hour="HH:mm"
            android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold"/>
        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="EEEE, d MMMM" android:format24Hour="EEEE, d MMMM"
            android:textColor="#BBBBBB" android:textSize="15sp" android:textStyle="bold"/>
        <TextView
            android:id="@+id/fest"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFB300" android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
